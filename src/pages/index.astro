---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPosts, eventOf, categoryOf, slugify, countBy, postUrl, DIFFICULTIES } from '../lib/posts';

const all = await getPosts();
const guide = all.find((p) => p.data.pin);
const writeups = all.filter((p) => !p.data.pin);

// Events, newest first (by their latest writeup).
const events = [...new Set(writeups.map(eventOf))];
const byEvent = events.map((e) => ({ name: e, posts: writeups.filter((p) => eventOf(p) === e) }));

const catCounts = countBy(writeups, categoryOf);
const categories = [...catCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const diffCounts = countBy(writeups, (p) => p.data.difficulty ?? 'unknown');
const diffs = DIFFICULTIES.filter((d) => diffCounts.has(d));
const langCounts = countBy(writeups, (p) => p.data.lang);

const filters = [
  { name: 'event', label: 'Event', options: events.map((e) => ({ value: slugify(e), label: e, n: byEvent.find((b) => b.name === e)!.posts.length })) },
  { name: 'category', label: 'Category', options: categories.map(([c, n]) => ({ value: slugify(c), label: c, n })) },
  { name: 'difficulty', label: 'Difficulty', options: diffs.map((d) => ({ value: d, label: d, n: diffCounts.get(d)! })) },
  { name: 'lang', label: 'Language', options: [...langCounts.entries()].map(([l, n]) => ({ value: l, label: l === 'fr' ? 'French' : 'English', n })) },
];
---

<Base section="writeups">
  <section class="intro">
    <h1>CTF writeups, from recon to root</h1>
    <p class="lede">
      {writeups.length} solves across {events.length} events. Each one walks the full chain, then names the root cause and
      the fix.
      {guide && <>{' '}Read <a href={postUrl(guide)}>how they are written</a>.</>}
    </p>
  </section>

  <section class="finder" aria-label="Filter writeups">
    <label class="search-field">
      <span class="visually-hidden">Filter writeups</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4.2-4.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input type="search" id="q" placeholder="Filter by title, technique or tag" autocomplete="off" data-search-input />
      <kbd aria-hidden="true">/</kbd>
    </label>

    <details class="filters" open>
      <summary>Filters <span id="active-count"></span></summary>
    <div class="filter-groups">
      {
        filters.map((f) => (
          <fieldset class="chips" data-filter={f.name}>
            <legend>{f.label}</legend>
            <label class="chip">
              <input type="radio" name={f.name} value="" checked />
              <span>All</span>
            </label>
            {f.options.map((o) => (
              <label class="chip">
                <input type="radio" name={f.name} value={o.value} />
                <span class:list={[f.name === 'difficulty' && `chip-diff diff-${o.value}`]}>
                  {o.label} <small>{o.n}</small>
                </span>
              </label>
            ))}
          </fieldset>
        ))
      }
    </div>
    </details>
    <p class="result-count" id="count" aria-live="polite"></p>
  </section>

  {
    byEvent.map((g) => (
      <section class="event-group" data-group>
        <h2 class="event-title">
          <a href={`#${slugify(g.name)}`} id={slugify(g.name)}>{g.name}</a>
          <span class="event-count">{g.posts.length} writeups</span>
        </h2>
        <ul class="post-list">
          {g.posts.map((p) => (
            <PostRow post={p} />
          ))}
        </ul>
      </section>
    ))
  }

  <div class="empty" id="empty" hidden>
    <p>No writeup matches these filters.</p>
    <button type="button" class="btn" id="reset">Clear filters</button>
  </div>
</Base>

<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const rows = [...document.querySelectorAll<HTMLElement>('.post-row')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const count = document.getElementById('count')!;
  const empty = document.getElementById('empty')!;
  const names = ['event', 'category', 'difficulty', 'lang'] as const;
  const total = rows.length;
  const activeCount = document.getElementById('active-count')!;
  // On phones the filters start collapsed, unless the URL already sets some.
  if (matchMedia('(max-width: 640px)').matches && !/[?&](event|category|difficulty|lang)=/.test(location.search))
    document.querySelector('.filters')!.removeAttribute('open');

  const value = (name: string) =>
    (document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? '');

  function apply(push = true) {
    const terms = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    const active = Object.fromEntries(names.map((n) => [n, value(n)]));
    let shown = 0;
    for (const r of rows) {
      const ok =
        names.every((n) => !active[n] || r.dataset[n] === active[n]) &&
        terms.every((t) => r.dataset.text!.includes(t));
      r.hidden = !ok;
      if (ok) shown++;
    }
    for (const g of groups) g.hidden = !g.querySelector('.post-row:not([hidden])');
    empty.hidden = shown > 0;
    count.textContent = shown === total ? '' : `${shown} of ${total} writeups`;
    const n = names.filter((k) => active[k]).length;
    activeCount.textContent = n ? `(${n} active)` : '';

    if (push) {
      const params = new URLSearchParams();
      if (q.value.trim()) params.set('q', q.value.trim());
      for (const n of names) if (active[n]) params.set(n, active[n]);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }
  }

  // Restore state from the URL so filtered views can be shared.
  const params = new URLSearchParams(location.search);
  q.value = params.get('q') ?? '';
  for (const n of names) {
    const v = params.get(n);
    const input = v && document.querySelector<HTMLInputElement>(`input[name="${n}"][value="${CSS.escape(v)}"]`);
    if (input) input.checked = true;
  }

  q.addEventListener('input', () => apply());
  document.querySelectorAll('.chips input').forEach((i) => i.addEventListener('change', () => apply()));
  document.getElementById('reset')!.addEventListener('click', () => {
    q.value = '';
    for (const n of names) document.querySelector<HTMLInputElement>(`input[name="${n}"][value=""]`)!.checked = true;
    apply();
    q.focus();
  });
  apply(false);
</script>
