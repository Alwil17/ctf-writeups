---
import Base from '../layouts/Base.astro';
import { url } from '../lib/posts';
---

<Base title="Page not found">
  <section class="intro not-found">
    <p class="code-404" aria-hidden="true">404</p>
    <h1>This page does not exist</h1>
    <p class="lede">The link may be old or mistyped. Every writeup is listed on the home page, or you can search them.</p>
    <p class="actions">
      <a class="btn" href={url('/')}>Browse writeups</a>
      <a class="btn btn-ghost" href={url('/search/')}>Search</a>
    </p>
  </section>
</Base>
